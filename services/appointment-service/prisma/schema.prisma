generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "mysql"
 url      = env("DATABASE_URL")
}

model Appointment {

 id           Int @id @default(autoincrement())

 patient_id   Int
 doctor_id    Int
 service_id   Int

 appointment_date DateTime

 status       String
 @@map("appointment")

 created_at   DateTime @default(now())

}