generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "mysql"
 url      = env("DATABASE_URL")
}

model Doctor {

 id          Int @id @default(autoincrement())
 first_name  String
 last_name   String
 department  String
 phone       String
 email       String
 @@map("doctor")

 created_at  DateTime @default(now())

}